---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { SHOPS } from '../data/site';
---

<BaseLayout title="Page not found" description="That page does not exist." noindex>
  <div class="nf">
    <p class="eyebrow">Error 404</p>
    <h1>This page has been repotted.</h1>
    <p class="nf__lead">
      The link is broken or the product has moved. Try a search, or start from one of the shops.
    </p>
    <div class="nf__cta">
      <Button href="/en/search" size="lg" icon="search">Search the catalogue</Button>
      <Button href="/en/" size="lg" variant="secondary">Back to home</Button>
    </div>
    <ul class="nf__shops" role="list">
      {SHOPS.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
    </ul>
  </div>
</BaseLayout>

<style>
  .nf {
    max-width: 46rem;
    margin-inline: auto;
    padding-block: clamp(3rem, 10vw, 6rem);
    text-align: center;
  }

  .nf h1 {
    margin-block: 0.6rem 0;
    font-size: var(--step-5);
  }

  .nf__lead {
    max-width: 46ch;
    margin: 1rem auto 0;
    color: var(--ink-2);
    font-size: var(--step-1);
  }

  .nf__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-block-start: 1.8rem;
  }

  .nf__shops {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.2rem;
    padding: 1.5rem 0 0;
    margin: 2rem 0 0;
    list-style: none;
    border-block-start: 1px solid var(--line);
    font-size: var(--step--1);
  }
</style>
