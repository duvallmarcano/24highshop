---
import type { QA } from '../../lib/seo';
import { faqSchema } from '../../lib/seo';

interface Props {
  items: QA[];
  title?: string;
  /** Set false when another block on the page already emits FAQPage. */
  schema?: boolean;
  class?: string;
}

const { items, title = 'Common questions', schema = true, class: className } = Astro.props;
---

{
  items.length > 0 && (
    <section class:list={['faq', className]}>
      <h2 class="faq__title">{title}</h2>
      <div class="faq__list">
        {items.map((item, i) => (
          <details class="faq__item" open={i === 0}>
            <summary>
              <span>{item.q}</span>
              <span class="faq__sign" aria-hidden="true" />
            </summary>
            <div class="faq__answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))}
      </div>
      {schema && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema(items))} />
      )}
    </section>
  )
}

<style>
  .faq__title {
    font-size: var(--step-2);
    margin-block-end: 1.2rem;
  }

  .faq__list {
    border-block-start: 1px solid var(--line);
  }

  .faq__item {
    border-block-end: 1px solid var(--line);
  }

  .faq__item summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1rem;
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary:hover { color: var(--spruce); }

  /* flat plus/minus drawn from two rules */
  .faq__sign {
    position: relative;
    flex: none;
    width: 12px;
    height: 12px;
    margin-block-start: 0.3rem;
  }

  .faq__sign::before,
  .faq__sign::after {
    content: '';
    position: absolute;
    background: currentcolor;
    transition: transform 0.16s ease, opacity 0.16s ease;
  }

  .faq__sign::before { inset-block-start: 5px; inset-inline: 0; height: 1.5px; }
  .faq__sign::after  { inset-inline-start: 5px; inset-block: 0; width: 1.5px; }

  .faq__item[open] .faq__sign::after { transform: rotate(90deg); opacity: 0; }

  .faq__answer {
    padding-block-end: 1.1rem;
    max-width: 62ch;
    color: var(--ink-2);
    line-height: 1.65;
  }
</style>
