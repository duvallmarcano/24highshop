---
interface Props {
  title?: string;
  lead?: string;
  href?: string;
  linkLabel?: string;
  class?: string;
}
const { title, lead, href, linkLabel = 'See all', class: className } = Astro.props;
---

<section class:list={['section', className]}>
  {
    (title || lead) && (
      <div class="section__head">
        <div>
          {title && <h2>{title}</h2>}
          {lead && <p class="section__lead">{lead}</p>}
        </div>
        {href && (
          <a class="section__link" href={href}>
            {linkLabel}
          </a>
        )}
      </div>
    )
  }
  <slot />
</section>

<style>
  .section {
    margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
  }

  .section__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-block-end: 1.3rem;
  }

  .section__head h2 {
    font-size: var(--step-3);
  }

  .section__lead {
    margin-block-start: 0.4rem;
    max-width: 52ch;
    color: var(--ink-2);
    font-size: var(--step-0);
  }

  .section__link {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
