---
import { SHOPS, SITE, LOCALES } from '../../data/site';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('en');
const year = new Date().getFullYear();

const company = [
  { label: 'About 24High', href: '/en/about' },
  { label: 'Our writers', href: '/en/authors' },
  { label: 'Editorial standards', href: '/en/editorial-policy' },
  { label: 'Guides', href: '/en/blog' },
  { label: 'Contact', href: '/en/contact' },
];

const legal = [
  { label: 'Shipping & returns', href: '/en/shipping' },
  { label: 'Terms & conditions', href: '/en/terms' },
  { label: 'Privacy policy', href: '/en/privacy' },
  { label: 'Cookie policy', href: '/en/cookies' },
  { label: 'Disclaimer', href: '/en/disclaimer' },
];

// Swiss payment rails, written rather than shown — the source site's payment
// logos were Dutch and Belgian (iDEAL, Bancontact) and do not apply here.
const payments = ['TWINT', 'PostFinance', 'Visa', 'Mastercard', 'Invoice'];
---

<footer class="ftr">
  <div class="container">
    <ul class="ftr__usp" role="list">
      <li>
        <strong>{t('usp.shipping')}</strong>
        <span>{t('usp.shippingSub')}</span>
      </li>
      <li>
        <strong>{t('usp.packaging')}</strong>
        <span>{t('usp.packagingSub')}</span>
      </li>
      <li>
        <strong>{t('usp.payment')}</strong>
        <span>{t('usp.paymentSub')}</span>
      </li>
      <li>
        <strong>{t('usp.origin')}</strong>
        <span>{t('usp.originSub')}</span>
      </li>
    </ul>

    <div class="ftr__grid">
      <div class="ftr__brand">
        <a class="ftr__logo" href="/en/">24High</a>
        <p class="ftr__tag">{SITE.description}</p>

        {/* Consistent NAP — the same name, address and contact everywhere. */}
        <address class="ftr__nap">
          <span>{SITE.legalName}</span>
          <span>{SITE.address.street}</span>
          <span>{SITE.address.postalCode} {SITE.address.locality}, {SITE.address.countryName}</span>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </address>

        <p class="ftr__age">{t('footer.age')}</p>
      </div>

      <nav class="ftr__col" aria-label="Shop">
        <h2>{t('footer.shop')}</h2>
        <ul role="list">
          {SHOPS.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
        </ul>
      </nav>

      <nav class="ftr__col" aria-label="Company">
        <h2>{t('footer.company')}</h2>
        <ul role="list">
          {company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>

      <nav class="ftr__col" aria-label="Legal">
        <h2>{t('footer.legal')}</h2>
        <ul role="list">
          {legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>

      <div class="ftr__col">
        <h2>{t('footer.languages')}</h2>
        <ul role="list">
          {
            LOCALES.map((l) => (
              <li>
                {l.enabled ? (
                  <a href="/en/" hreflang={l.hreflang} lang={l.code}>{l.label}</a>
                ) : (
                  <span class="ftr__soon">{l.label}</span>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="ftr__pay">
      <span class="eyebrow">Payment</span>
      <ul role="list">
        {payments.map((p) => <li>{p}</li>)}
      </ul>
    </div>

    <div class="ftr__base">
      <p>&copy; {SITE.established}–{year} {SITE.legalName}, {SITE.address.locality}. {t('footer.rights')}</p>
      <p>{SITE.uid} · {t('footer.vatNote')}</p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    margin-block-start: clamp(4rem, 10vw, 8rem);
    border-block-start: 1px solid var(--line);
    font-size: var(--step--1);
  }

  .ftr__usp {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: 0;
    padding: 0;
    margin: 0;
    list-style: none;
    border-block-end: 1px solid var(--line);
  }

  .ftr__usp li {
    padding: 1.4rem 1.4rem 1.4rem 0;
  }

  .ftr__usp strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--ink);
  }

  .ftr__usp span {
    color: var(--ink-3);
    font-size: var(--step--2);
  }

  .ftr__grid {
    display: grid;
    grid-template-columns: 1.7fr repeat(4, minmax(0, 1fr));
    gap: 2.5rem 1.5rem;
    padding-block: 3rem;
  }

  .ftr__logo {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.045em;
    color: var(--ink);
    text-decoration: none;
  }

  .ftr__tag {
    max-width: 34ch;
    margin-block: 0.8rem 1.2rem;
    color: var(--ink-2);
    line-height: 1.55;
  }

  .ftr__nap {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-style: normal;
    color: var(--ink-3);
    font-size: var(--step--2);
    font-family: var(--font-mono);
  }

  .ftr__nap a { color: var(--ink-3); }

  .ftr__age {
    margin-block-start: 1.2rem;
    padding-block-start: 0.9rem;
    border-block-start: 1px solid var(--line);
    color: var(--warn);
    font-size: var(--step--2);
  }

  .ftr__col h2 {
    margin-block-end: 0.9rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .ftr__col ul {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .ftr__col a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .ftr__col a:hover { color: var(--spruce); }

  .ftr__soon { color: var(--ink-3); opacity: 0.6; }

  .ftr__pay {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 1.2rem;
    border-block-start: 1px solid var(--line);
  }

  .ftr__pay ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .ftr__pay li {
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-2);
  }

  .ftr__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    padding-block: 1.2rem 2rem;
    border-block-start: 1px solid var(--line);
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }

  @media (max-width: 900px) {
    .ftr__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ftr__brand { grid-column: 1 / -1; }
  }
</style>
