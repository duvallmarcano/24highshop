---
import { toCHF } from '../../data/site';

interface Props {
  /** Catalogue price, always in EUR. CHF is derived. */
  value: number | null;
  size?: 'sm' | 'md' | 'lg';
  /** Show the EUR equivalent beneath. */
  showEUR?: boolean;
  class?: string;
}

const { value, size = 'md', showEUR = false, class: className } = Astro.props;

const chf = value === null ? null : toCHF(value);
const fmt = (n: number, cur: string) =>
  new Intl.NumberFormat('de-CH', { style: 'currency', currency: cur }).format(n);
---

<span class:list={['price', `price--${size}`, className]}>
  <span class="price__chf">{chf === null ? '—' : fmt(chf, 'CHF')}</span>
  {
    showEUR && value !== null && (
      <span class="price__eur">{fmt(value, 'EUR')}</span>
    )
  }
</span>

<style>
  .price {
    display: inline-flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .price__chf {
    font-family: var(--font-display);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    color: var(--ink);
    line-height: 1.1;
  }

  .price__eur {
    font-family: var(--font-mono);
    font-size: 0.7em;
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
  }

  .price--sm .price__chf { font-size: var(--step-0); }
  .price--md .price__chf { font-size: var(--step-2); }
  .price--lg .price__chf { font-size: var(--step-4); }
</style>
