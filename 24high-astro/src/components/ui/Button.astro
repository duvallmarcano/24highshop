---
import Icon from './Icon.astro';
import type { IconName } from '../../lib/icons';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  icon?: IconName;
  iconEnd?: IconName;
  block?: boolean;
  type?: 'button' | 'submit';
  disabled?: boolean;
  class?: string;
  'aria-label'?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  iconEnd,
  block = false,
  type = 'button',
  disabled = false,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const classes = ['btn', `btn--${variant}`, `btn--${size}`, block && 'btn--block', className];
---

<Tag
  class:list={classes}
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  {...rest}
>
  {icon && <Icon name={icon} size={size === 'lg' ? 20 : 16} />}
  <span><slot /></span>
  {iconEnd && <Icon name={iconEnd} size={size === 'lg' ? 20 : 16} />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-weight: 550;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid transparent;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .btn--sm { padding: 0.5rem 0.8rem; font-size: var(--step--1); }
  .btn--md { padding: 0.7rem 1.1rem; font-size: var(--step-0); }
  .btn--lg { padding: 0.9rem 1.5rem; font-size: var(--step-1); }

  .btn--block { display: flex; width: 100%; }

  .btn--primary {
    background: var(--spruce);
    color: var(--ink-on-brand);
  }
  .btn--primary:hover { background: var(--spruce-hover); }

  .btn--secondary {
    background: var(--surface);
    border-color: var(--line);
    color: var(--ink);
  }
  .btn--secondary:hover { border-color: var(--spruce); color: var(--spruce); }

  .btn--ghost {
    background: transparent;
    color: var(--ink-2);
  }
  .btn--ghost:hover { background: var(--surface-2); color: var(--ink); }

  .btn[disabled] { opacity: 0.5; cursor: not-allowed; }
</style>
