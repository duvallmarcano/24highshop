---
import type { IconName } from '../../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Give this only when the icon carries meaning on its own. */
  label?: string;
}

const { name, size = 20, class: className, label } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
><use href={`#i-${name}`} /></svg>

<style>
  .icon {
    flex: none;
    display: inline-block;
    vertical-align: middle;
  }
</style>
