---
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Price from '../ui/Price.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  title: string;
  sku: string;
  price: number | null;
  currency?: string;
  inStock?: boolean;
}

const { title, sku, price, currency = 'EUR', inStock = true } = Astro.props;
---

<div class="buybox">
  <div class="buybox__row">
    <Price value={price} currency={currency} size="lg" />
    <Badge tone={inStock ? 'ok' : 'warn'}>{inStock ? 'In stock' : 'Sold out'}</Badge>
  </div>
  <p class="buybox__vat">Incl. VAT · shipped from the Netherlands</p>

  <form class="buybox__form" data-cart-form data-sku={sku} data-title={title}>
    <label class="visually-hidden" for="qty">Quantity</label>
    <input id="qty" name="qty" type="number" min="1" max="99" value="1" class="qty" />
    <Button type="submit" icon="cart" size="lg" block disabled={!inStock}>
      {inStock ? 'Add to basket' : 'Notify me'}
    </Button>
  </form>

  <ul class="buybox__usp" role="list">
    <li><Icon name="truck" size={16} /> Free shipping over &euro;50</li>
    <li><Icon name="package" size={16} /> Discreet, unmarked packaging</li>
    <li><Icon name="clock" size={16} /> Ordered before 17:00, shipped today</li>
  </ul>

  <p class="buybox__sku">SKU {sku}</p>
</div>

<style>
  .buybox {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.3rem;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .buybox__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .buybox__vat {
    margin-block-start: -0.6rem;
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  .buybox__form {
    display: flex;
    gap: 0.6rem;
  }

  .qty {
    width: 4.2rem;
    padding: 0.7rem 0.6rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .buybox__usp {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 0.9rem 0 0;
    margin: 0;
    list-style: none;
    border-block-start: 1px solid var(--line-soft);
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .buybox__usp li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .buybox__usp :global(.icon) {
    color: var(--spruce);
  }

  .buybox__sku {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }
</style>
