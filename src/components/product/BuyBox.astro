---
import Button from '../ui/Button.astro';
import Price from '../ui/Price.astro';
import Money from '../ui/Money.astro';
import Icon from '../ui/Icon.astro';
import { SITE, MIN_ORDER_EUR, toCHF, DEFAULT_LOCALE, type LocaleCode } from '../../data/site';
import { exVat } from '../../lib/seo';
import { useTranslations } from '../../i18n/ui';

interface Props {
  title: string;
  sku: string;
  price: number | null;
  inStock?: boolean;
  lang?: LocaleCode;
}

const { title, sku, price, inStock = true, lang = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(lang);

const chf = price === null ? null : toCHF(price);
const net = chf === null ? null : exVat(chf);
const netEUR = price === null ? null : exVat(price);
const minCHF = toCHF(MIN_ORDER_EUR);

// these two strings wrap a price element, so they are split rather than
// interpolated — word order around the amount differs by language
const [vatBefore, vatAfter] = t('buy.exVat').split('{net}');
const [minBefore, minAfter] = t('buy.minOrder').split('{amount}');

// How many of this item it takes to reach the minimum order value.
const needed = price === null || price >= MIN_ORDER_EUR
  ? 0
  : Math.ceil(MIN_ORDER_EUR / price);
---

<div class="buy">
  <div class="buy__price">
    <Price value={price} size="lg" />
  </div>

  <p class="buy__vat">
    {
      net !== null ? (
        <>
          {vatBefore}<Money eur={netEUR!} chf={net} />{vatAfter}
        </>
      ) : (
        t('buy.priceOnRequest')
      )
    }
  </p>

  <div class="buy__stock">
    <span class:list={['dot', inStock ? 'dot--ok' : 'dot--out']} aria-hidden="true"></span>
    {
      inStock
        ? t('buy.inStockAt', { city: SITE.address.locality, cutoff: SITE.cutoff })
        : t('buy.soldOutSoon')
    }
  </div>

  <form class="buy__form" data-cart-form data-sku={sku} data-title={title}>
    <label class="visually-hidden" for="qty">{t('product.quantity')}</label>
    <input id="qty" name="qty" type="number" min="1" max="99" value="1" class="qty" />
    <Button type="submit" icon="cart" size="lg" block disabled={!inStock}>
      {inStock ? t('product.addToBasket') : t('product.notify')}
    </Button>
  </form>

  {/* Stated on the product page, not discovered at checkout. */}
  <p class="buy__min">
    <Icon name="info" size={15} />
    <span>
      {minBefore}<Money eur={MIN_ORDER_EUR} chf={minCHF} />{minAfter}
      {needed > 1 && t('buy.minOrderHint', { n: needed })}
    </span>
  </p>

  <ul class="buy__usp" role="list">
    <li><Icon name="truck" size={15} /> {t('buy.uspShipping')}</li>
    <li><Icon name="package" size={15} /> {t('buy.uspPackaging')}</li>
    <li><Icon name="bitcoin" size={15} /> {t('buy.uspPayment')}</li>
  </ul>

  <p class="buy__sku">{t('product.sku')} {sku}</p>
</div>

<style>
  .buy {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.4rem;
    border: 1px solid var(--line-strong);
  }

  .buy__vat {
    margin-block-start: -0.6rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-3);
  }

  .buy__stock {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--ink-2);
    line-height: 1.45;
  }

  .dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    margin-block-start: 0.4rem;
  }

  .dot--ok { background: var(--ok); }
  .dot--out { background: var(--ink-3); }

  .buy__form {
    display: flex;
    gap: 0.5rem;
  }

  .qty {
    width: 4rem;
    padding: 0.7rem 0.5rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .buy__min {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.65rem 0.75rem;
    background: var(--warn-soft);
    color: var(--warn);
    font-size: var(--step--1);
    line-height: 1.45;
  }

  .buy__min :global(.icon) { margin-block-start: 0.15rem; flex: none; }

  .buy__usp {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 0.95rem 0 0;
    margin: 0;
    list-style: none;
    border-block-start: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .buy__usp li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .buy__usp :global(.icon) { color: var(--spruce); }

  .buy__sku {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }
</style>
