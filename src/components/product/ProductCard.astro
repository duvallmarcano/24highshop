---
import Price from '../ui/Price.astro';
import Stars from './Stars.astro';
import { firstImage, productSrcSet } from '../../lib/images';

interface Props {
  slug: string;
  title: string;
  price: number | null;
  inStock?: boolean;
  images?: string[];
  categoryLabel?: string;
  rating?: { value: number; count: number };
  compact?: boolean;
  eager?: boolean;
}

const {
  slug, title, price, inStock = true, images = [],
  categoryLabel = '', rating, compact = false, eager = false,
} = Astro.props;

const href = `/en/product/${slug}`;
const src = firstImage(images, 1000);
const srcset = images.length ? productSrcSet(images[0]) : undefined;
---

<article class:list={['card', compact && 'card--compact']}>
  <div class="card__media">
    <img
      src={src}
      srcset={srcset}
      sizes="(max-width: 600px) 45vw, 250px"
      alt=""
      width="250"
      height="250"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
    {!inStock && <span class="card__out">Sold out</span>}
  </div>

  <div class="card__body">
    {categoryLabel && <p class="card__cat">{categoryLabel}</p>}
    <h3 class="card__title"><a href={href}>{title}</a></h3>
    {
      rating && (
        <span class="card__rating">
          <Stars value={rating.value} size={12} />
          <span>({rating.count})</span>
        </span>
      )
    }
    <div class="card__foot">
      <Price value={price} size="sm" />
      {inStock && <span class="card__ready">In stock</span>}
    </div>
  </div>
</article>

<style>
  /* Flat: a hairline and the image do the work. Hover changes the rule, not
     the elevation — nothing lifts off the page. */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    transition: border-color 0.14s ease;
  }

  .card:hover,
  .card:focus-within { border-color: var(--ink); }

  .card__media {
    position: relative;
    aspect-ratio: 1;
    background: var(--surface-2);
    overflow: hidden;
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__out {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    padding: 0.25rem 0.5rem;
    background: var(--paper);
    border-inline-end: 1px solid var(--line);
    border-block-end: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.85rem 0.9rem 0.95rem;
  }

  .card__cat {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .card__title {
    font-size: var(--step-0);
    font-weight: 500;
    line-height: 1.28;
    letter-spacing: -0.012em;
  }

  .card__title a {
    color: var(--ink);
    text-decoration: none;
  }

  /* whole card is the hit target, without nesting interactive elements */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__rating {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-3);
  }

  .card__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem;
    margin-block-start: auto;
    padding-block-start: 0.7rem;
  }

  .card__ready {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ok);
  }

  .card--compact .card__body { padding: 0.7rem 0.75rem 0.8rem; }
  .card--compact .card__title { font-size: var(--step--1); }
</style>
