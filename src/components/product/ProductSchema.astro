---
import { productSchema, type ProductSchemaInput } from '../../lib/seo';

type Props = ProductSchemaInput;

// One place builds Product structured data, rather than 6,694 copies of it
// pasted through the catalogue.
const schema = productSchema(Astro.props);
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
