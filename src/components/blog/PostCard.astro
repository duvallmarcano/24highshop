---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../../lib/format';

interface Props {
  post: CollectionEntry<'blog'>;
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const { title, description, heroImage, publishedAt } = post.data;
const href = `/en/blog/${post.slug}`;
---

<article class="post">
  {
    heroImage && (
      <a class="post__media" href={href} tabindex="-1" aria-hidden="true">
        <img
          src={heroImage}
          alt=""
          width="400"
          height="300"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      </a>
    )
  }
  <div class="post__body">
    <time class="post__date" datetime={publishedAt}>{formatDate(publishedAt)}</time>
    <h3 class="post__title"><a href={href}>{title}</a></h3>
    <p class="post__excerpt">{description}</p>
  </div>
</article>

<style>
  .post {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: border-color 0.14s ease;
  }

  .post:hover,
  .post:focus-within { border-color: var(--ink); }

  .post__media {
    display: block;
    aspect-ratio: 4 / 3;
    background: var(--surface-2);
  }

  .post__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem 1.05rem 1.15rem;
  }

  .post__date {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .post__title {
    font-size: var(--step-1);
    line-height: 1.22;
    letter-spacing: -0.02em;
  }

  .post__title a {
    color: var(--ink);
    text-decoration: none;
  }

  .post__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post__title a:hover { color: var(--spruce); }

  .post__excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.55;
  }
</style>
