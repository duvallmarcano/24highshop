---
interface Props {
  tone?: 'neutral' | 'ok' | 'warn' | 'danger' | 'brand';
  class?: string;
}
const { tone = 'neutral', class: className } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`, className]}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.22em 0.55em;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .badge--neutral { background: var(--surface-2); color: var(--ink-2); }
  .badge--ok      { background: var(--ok-soft);     color: var(--ok); }
  .badge--warn    { background: var(--warn-soft);   color: var(--warn); }
  .badge--danger  { background: var(--danger-soft); color: var(--danger); }
  .badge--brand   { background: var(--spruce-soft); color: var(--spruce); }
</style>
