---
import Icon from './Icon.astro';
import type { IconName } from '../../lib/icons';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  icon?: IconName;
  iconEnd?: IconName;
  block?: boolean;
  type?: 'button' | 'submit';
  disabled?: boolean;
  class?: string;
  'aria-label'?: string;
}

const {
  href, variant = 'primary', size = 'md', icon, iconEnd,
  block = false, type = 'button', disabled = false, class: className, ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['btn', `btn--${variant}`, `btn--${size}`, block && 'btn--block', className]}
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  {...rest}
>
  {icon && <Icon name={icon} size={size === 'lg' ? 18 : 15} />}
  <span><slot /></span>
  {iconEnd && <Icon name={iconEnd} size={size === 'lg' ? 18 : 15} />}
</Tag>

<style>
  /* Flat: colour and a 1px rule carry the affordance. No shadow, no lift. */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.14s ease, border-color 0.14s ease, color 0.14s ease;
  }

  .btn--sm { padding: 0.52rem 0.85rem; font-size: var(--step--1); }
  .btn--md { padding: 0.72rem 1.15rem; font-size: var(--step-0); }
  .btn--lg { padding: 0.95rem 1.6rem; font-size: var(--step-1); }

  .btn--block { display: flex; width: 100%; }

  .btn--primary {
    background: var(--spruce);
    color: var(--ink-on-brand);
  }
  .btn--primary:hover { background: var(--spruce-hover); }

  .btn--secondary {
    border-color: var(--line-strong);
    color: var(--ink);
  }
  .btn--secondary:hover { border-color: var(--ink); }

  .btn--ghost { color: var(--ink-2); }
  .btn--ghost:hover { color: var(--spruce); }

  .btn[disabled] { opacity: 0.45; cursor: not-allowed; }
</style>
