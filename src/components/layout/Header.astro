---
import Icon from '../ui/Icon.astro';
import { SHOPS, UTILITY_NAV, LOCALES, SITE } from '../../data/site';
import { useTranslations } from '../../i18n/ui';

interface Props {
  activeShop?: string;
}

const { activeShop } = Astro.props;
const t = useTranslations('en');

// Headshop alone has 35 categories. A dropdown listing every one is both
// unusable and, repeated across 1,800 pages, the largest thing on the page.
const MEGA_LIMIT = 10;
---

<header class="hdr">
  <div class="hdr__promo">
    <div class="container hdr__promo-in">
      <span>{t('promo.shipping')}</span>
      <span class="dot" aria-hidden="true">/</span>
      <span>{t('promo.packaging')}</span>
      <span class="dot" aria-hidden="true">/</span>
      <span>{t('promo.since', { year: SITE.established })}</span>
    </div>
  </div>

  <div class="hdr__bar">
    <div class="container hdr__bar-in">
      <button
        class="hdr__burger"
        type="button"
        aria-label={t('nav.openMenu')}
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <Icon name="menu" size={20} />
      </button>

      <a class="hdr__logo" href="/en/">
        <span class="hdr__logo-a">24high</span><span class="hdr__logo-b">shop</span>
        <span class="hdr__ch" aria-hidden="true">CH</span>
      </a>

      <form class="hdr__search" action="/en/search" method="get" role="search">
        <Icon name="search" size={16} class="hdr__search-icon" />
        <label class="visually-hidden" for="q">{t('nav.searchLabel')}</label>
        <input id="q" name="q" type="search" placeholder={t('nav.search')} autocomplete="off" />
      </form>

      <div class="hdr__actions">
        <button class="hdr__act" type="button" data-theme-toggle aria-label={t('nav.theme')}>
          <Icon name="sun" size={17} class="icon-light" />
          <Icon name="moon" size={17} class="icon-dark" />
        </button>

        <a class="hdr__act hdr__cart" href="/en/cart" aria-label={t('nav.basket')}>
          <Icon name="cart" size={17} />
          <span class="hdr__count" data-cart-count hidden>0</span>
        </a>
      </div>
    </div>
  </div>

  <nav class="nav" aria-label="Shop categories">
    <div class="container">
      <ul class="nav__list" role="list">
        {
          SHOPS.map((shop) => (
            <li class="nav__item" data-shop={shop.id}>
              <a
                class:list={['nav__link', activeShop === shop.id && 'nav__link--active']}
                href={shop.href}
              >
                {shop.label}
              </a>

              <div class="mega">
                <div class="mega__in container">
                  <div class="mega__lead">
                    <span class="mega__icon"><Icon name={shop.icon} size={30} /></span>
                    <p class="mega__blurb">{shop.blurb}</p>
                    <a class="mega__all" href={shop.href}>
                      {t('nav.allProducts', { n: shop.total })}
                      <Icon name="arrow-right" size={14} />
                    </a>
                  </div>
                  <ul class="mega__cols" role="list">
                    {shop.categories.slice(0, MEGA_LIMIT).map((c) => (
                      <li>
                        <a href={c.href}>
                          {c.label}
                          <span class="mega__n">{c.count}</span>
                        </a>
                      </li>
                    ))}
                    {shop.categories.length > MEGA_LIMIT && (
                      <li>
                        <a class="mega__rest" href={shop.href}>
                          {t('nav.moreCategories', { n: shop.categories.length - MEGA_LIMIT })}
                        </a>
                      </li>
                    )}
                  </ul>
                </div>
              </div>
            </li>
          ))
        }
        {
          UTILITY_NAV.map((l) => (
            <li class="nav__item">
              <a class="nav__link" href={l.href}>
                {l.label}
              </a>
            </li>
          ))
        }

        <li class="nav__item nav__item--end">
          <details class="langsel">
            <summary aria-label={t('nav.language')}>
              <Icon name="external" size={13} />
              English
              <Icon name="chevron-down" size={12} />
            </summary>
            <ul role="list">
              {
                LOCALES.map((l) => (
                  <li>
                    {l.enabled ? (
                      <a
                        href={`/${l.code}/`}
                        hreflang={l.hreflang}
                        lang={l.code}
                        aria-current={l.code === 'en' ? 'true' : undefined}
                      >
                        {l.label}
                      </a>
                    ) : (
                      <span class="langsel__soon" lang={l.code}>
                        {l.label} <em>soon</em>
                      </span>
                    )}
                  </li>
                ))
              }
            </ul>
          </details>
        </li>
      </ul>
    </div>
  </nav>

  <div class="drawer" id="mobile-nav" hidden>
    <div class="drawer__head">
      <span>{t('nav.menu')}</span>
      <button type="button" aria-label={t('nav.closeMenu')} data-menu-close>
        <Icon name="close" size={20} />
      </button>
    </div>
    <nav aria-label="Mobile navigation">
      <ul class="drawer__list" role="list">
        {
          SHOPS.map((shop) => (
            <li data-shop={shop.id}>
              <a href={shop.href}>
                <span class="drawer__label">
                  <Icon name={shop.icon} size={18} />
                  {shop.label}
                </span>
                <span class="drawer__n">{shop.total}</span>
              </a>
            </li>
          ))
        }
        {
          UTILITY_NAV.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="drawer__scrim" hidden data-menu-close></div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const drawer = document.getElementById('mobile-nav');
  const scrim = document.querySelector<HTMLElement>('.drawer__scrim');

  function setMenu(open: boolean) {
    if (!drawer || !scrim || !toggle) return;
    drawer.hidden = !open;
    scrim.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  }

  toggle?.addEventListener('click', () => setMenu(drawer?.hidden ?? true));
  document
    .querySelectorAll('[data-menu-close]')
    .forEach((el) => el.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });
</script>

<style>
  .hdr {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: var(--paper);
    border-block-end: 1px solid var(--line);
  }

  /* --- promo rail --- */
  .hdr__promo {
    border-block-end: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.02em;
    color: var(--ink-3);
  }

  .hdr__promo-in {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding-block: 0.45rem;
  }

  .dot { opacity: 0.4; }

  @media (max-width: 720px) {
    .hdr__promo-in > :nth-child(n + 3) { display: none; }
  }

  /* --- bar --- */
  .hdr__bar-in {
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 2vw, 1.6rem);
    padding-block: 0.85rem;
  }

  .hdr__burger {
    display: none;
    color: var(--ink);
  }

  .hdr__logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    font-family: var(--font-display);
    font-size: 1.28rem;
    letter-spacing: -0.045em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .hdr__logo-a { font-weight: 700; }
  .hdr__logo-b { font-weight: 400; color: var(--ink-3); }
  .hdr__logo:hover .hdr__logo-b { color: var(--spruce); }

  .hdr__ch {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    color: var(--spruce);
    border: 1px solid currentcolor;
    padding: 0.1rem 0.2rem;
    translate: 0 -0.2rem;
  }

  .hdr__search {
    position: relative;
    flex: 1;
    max-width: 28rem;
  }

  .hdr__search :global(.hdr__search-icon) {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0.65rem;
    translate: 0 -50%;
    color: var(--ink-3);
    pointer-events: none;
  }

  .hdr__search input {
    width: 100%;
    padding: 0.55rem 0.8rem 0.55rem 2.1rem;
    background: var(--surface-2);
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-size: var(--step--1);
  }

  .hdr__search input:focus-visible { border-color: var(--spruce); }

  .hdr__actions {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    margin-inline-start: auto;
  }

  .hdr__act {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    color: var(--ink-2);
    text-decoration: none;
  }

  .hdr__act:hover { color: var(--spruce); }

  .hdr__count {
    position: absolute;
    inset-block-start: 0.1rem;
    inset-inline-end: 0;
    min-width: 0.95rem;
    padding: 0 0.15rem;
    background: var(--spruce);
    color: var(--ink-on-brand);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    line-height: 0.95rem;
    text-align: center;
  }

  .hdr__act :global(.icon-dark) { display: none; }
  :global(:root[data-theme='dark']) .hdr__act :global(.icon-dark) { display: block; }
  :global(:root[data-theme='dark']) .hdr__act :global(.icon-light) { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .hdr__act :global(.icon-dark) { display: block; }
    :global(:root:not([data-theme='light'])) .hdr__act :global(.icon-light) { display: none; }
  }

  /* --- language --- */
  .langsel { position: relative; }

  .langsel summary {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding-block: 0.7rem;
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-2);
    cursor: pointer;
    list-style: none;
  }

  .langsel summary::-webkit-details-marker { display: none; }
  .langsel summary:hover { color: var(--spruce); }

  .langsel ul {
    position: absolute;
    inset-block-start: 100%;
    inset-inline-end: 0;
    min-width: 10rem;
    padding: 0.25rem;
    margin: 0;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--line-strong);
  }

  .langsel :is(a, .langsel__soon) {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0.55rem;
    font-size: var(--step--1);
    text-decoration: none;
  }

  .langsel a { color: var(--ink); }
  .langsel a:hover { background: var(--surface-2); }

  .langsel__soon { color: var(--ink-3); }
  .langsel__soon em {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* --- category nav --- */
  .nav { border-block-start: 1px solid var(--line); }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .nav__item--end { margin-inline-start: auto; }

  .nav__item { position: static; }

  .nav__link {
    display: inline-block;
    padding-block: 0.7rem;
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    border-block-end: 1px solid transparent;
  }

  .nav__link:hover,
  .nav__link--active {
    color: var(--ink);
    border-block-end-color: var(--accent);
    border-block-end-width: 2px;
  }

  /* --- mega --- */
  .mega {
    border-block-start: 2px solid var(--accent);
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    z-index: 40;
    background: var(--paper);
    border-block-end: 1px solid var(--line);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.12s ease, visibility 0.12s;
  }

  .nav__item:hover .mega,
  .nav__item:focus-within .mega {
    opacity: 1;
    visibility: visible;
  }

  .mega__in {
    display: grid;
    grid-template-columns: 17rem 1fr;
    gap: 3rem;
    padding-block: 1.6rem 2rem;
  }

  .mega__icon {
    display: block;
    margin-block-end: 0.7rem;
    color: var(--accent);
  }

  .mega__blurb {
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.55;
    margin-block-end: 0.9rem;
  }

  .mega__all {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
  }

  .mega__cols {
    columns: 3;
    column-gap: 2rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .mega__cols li { break-inside: avoid; }

  .mega__cols a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    padding-block: 0.3rem;
    color: var(--ink-2);
    font-size: var(--step--1);
    text-decoration: none;
  }

  .mega__cols a:hover { color: var(--accent); }

  .mega__n {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .mega__rest { color: var(--accent) !important; font-weight: 500; }

  /* --- drawer --- */
  .drawer {
    position: fixed;
    inset-block: 0;
    inset-inline-start: 0;
    z-index: 60;
    width: min(86vw, 20rem);
    background: var(--paper);
    border-inline-end: 1px solid var(--line);
    overflow-y: auto;
  }

  .drawer__scrim {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: rgb(0 0 0 / 45%);
  }

  .drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.2rem;
    border-block-end: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: 600;
  }

  .drawer__list {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .drawer__list a {
    display: flex;
    justify-content: space-between;
    padding: 0.9rem 1.2rem;
    border-block-end: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }

  .drawer__label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .drawer__label :global(.icon) { color: var(--accent); }

  .drawer__n {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-3);
  }

  @media (max-width: 920px) {
    .hdr__burger { display: grid; place-items: center; width: 2.1rem; height: 2.1rem; }
    .nav { display: none; }
  }

  @media (min-width: 921px) {
    .drawer,
    .drawer__scrim { display: none !important; }
  }

  @media (max-width: 640px) {
    .hdr__search,
    .langsel { display: none; }
  }
</style>
