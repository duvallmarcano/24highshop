---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/layout/Breadcrumbs.astro';
import ProductGrid from '../../../../components/product/ProductGrid.astro';
import FAQ from '../../../../components/seo/FAQ.astro';
import KeyFacts from '../../../../components/seo/KeyFacts.astro';
import Money from '../../../../components/ui/Money.astro';
import { SHOPS, toCHF, SITE, type Shop, type Category, type ShopId } from '../../../../data/site';
import { SHOP_FAQ } from '../../../../data/faq';
import {
  breadcrumbSchema,
  collectionPageSchema,
  itemListSchema,
} from '../../../../lib/seo';
import { alignDescription, keywordsFor, relatedGuides } from '../../../../lib/keywords';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return SHOPS.flatMap((shop) =>
    shop.categories.map((category) => ({
      params: { shop: shop.id, category: category.slug },
      props: {
        shop,
        category,
        products: products.filter(
          (p) => p.data.shop === shop.id && p.data.category === category.slug
        ),
      },
    }))
  );
}

interface Props {
  shop: Shop;
  category: Category;
  products: CollectionEntry<'products'>[];
}

const { shop, category, products } = Astro.props;

// in stock first, then cheapest — the order a shopper actually wants
const sorted = [...products].sort((a, b) => {
  if (a.data.inStock !== b.data.inStock) return a.data.inStock ? -1 : 1;
  return (a.data.price ?? Infinity) - (b.data.price ?? Infinity);
});

const prices = products.map((p) => p.data.price).filter((p): p is number => p !== null);
const fromEUR = prices.length ? Math.min(...prices) : null;
const toEUR = prices.length ? Math.max(...prices) : null;
const fromCHF = fromEUR === null ? null : toCHF(fromEUR);
const toCHFmax = toEUR === null ? null : toCHF(toEUR);
const available = products.filter((p) => p.data.inStock).length;

const url = `/en/shop/${shop.id}/${category.slug}`;
const crumbs = [
  { label: 'Home', href: '/en/' },
  { label: shop.label, href: shop.href },
  { label: category.label },
];

// A direct-answer opening paragraph: what this category is, how many, from
// what price, how fast it ships. Written to be quotable in one lift.
// Split in two so the visible price can follow the switcher while the meta
// description keeps the canonical franc figure.
const answerLead = `24highshop stocks ${products.length} ${category.label.toLowerCase()}`;
const answerTail = `, shipped from ${SITE.address.locality} in plain packaging. ${available} ${
  available === 1 ? 'is' : 'are'
} in stock today and dispatch the same working day when ordered before ${SITE.cutoff}.`;
const answer = `${answerLead}${
  fromCHF !== null ? ` from CHF ${fromCHF.toFixed(2)}` : ''
}${answerTail}`;

const facts = [
  { label: 'Products', value: String(products.length) },
  { label: 'In stock', value: String(available) },
  ...(fromEUR !== null && toEUR !== null
    ? [{ label: 'From', eur: fromEUR, chf: fromCHF! }, { label: 'Up to', eur: toEUR, chf: toCHFmax! }]
    : []),
  { label: 'Shop', value: shop.label },
  { label: 'Delivery', value: '1–2 working days in Switzerland' },
];

const rawDescription = `${category.label} at 24highshop — ${products.length} products${
  fromCHF !== null ? ` from CHF ${fromCHF.toFixed(2)}` : ''
}. Shipped discreetly from Zürich in 1–2 working days.`;

// Phrase the description in the words this page already ranks for, and pull
// in guides that serve the same searches.
const description = alignDescription(rawDescription, url);
const terms = keywordsFor(url).filter((k) => k.volume >= 50).slice(0, 8);
const guides = relatedGuides(url, 3);
---

<BaseLayout
  title={`${category.label} — ${shop.label}`}
  description={description}
  activeShop={shop.id}
  schemas={[
    breadcrumbSchema(crumbs),
    collectionPageSchema(category.label, description, url),
    itemListSchema(
      sorted.map((p) => ({ slug: p.slug, title: p.data.title, price: p.data.price })),
      category.label
    ),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <header class="cat" data-shop={shop.id}>
    <div class="cat__lead">
      <p class="eyebrow">{shop.label}</p>
      <h1>{category.label}</h1>
      <p class="cat__answer">
        {answerLead}
        {fromEUR !== null && (
          <> from <Money eur={fromEUR} chf={fromCHF!} /></>
        )}
        {answerTail}
      </p>
    </div>
    <div class="cat__facts">
      <KeyFacts facts={facts} />
    </div>
  </header>

  {
    sorted.length > 0 ? (
      <ProductGrid products={sorted} eagerCount={8} />
    ) : (
      <p class="empty">
        Nothing in this category right now.{' '}
        <a href={shop.href}>Browse all {shop.label.toLowerCase()}</a>.
      </p>
    )
  }

  <section class="cat__faq">
    <FAQ items={SHOP_FAQ[shop.id as ShopId] ?? []} title={`${shop.label} — common questions`} />
  </section>

  {
    guides.length > 0 && (
      <section class="guides">
        <h2>Guides for {category.label.toLowerCase()}</h2>
        <ul role="list">
          {guides.map((g) => (
            <li>
              <a href={g.route}>
                {g.route
                  .replace('/en/blog/', '')
                  .replace(/-/g, ' ')
                  .replace(/^./, (c) => c.toUpperCase())}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <nav class="siblings" aria-label={`Other ${shop.label} categories`} data-shop={shop.id}>
    <h2 class="eyebrow">More in {shop.label}</h2>
    <ul role="list">
      {
        shop.categories
          .filter((c) => c.slug !== category.slug)
          .slice(0, 14)
          .map((c) => (
            <li>
              <a href={c.href}>
                {c.label} <span>{c.count}</span>
              </a>
            </li>
          ))
      }
    </ul>
  </nav>
</BaseLayout>

<style>
  .cat {
    border-block-start: 4px solid var(--accent);
    padding-block-start: 1.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
    margin-block: 1.5rem 2.5rem;
    padding-block-end: 2rem;
    border-block-end: 1px solid var(--line);
  }

  .cat h1 {
    margin-block: 0.6rem 0;
    font-size: var(--step-5);
    letter-spacing: -0.04em;
  }

  /* the lift-able answer paragraph */
  .cat__answer {
    max-width: 60ch;
    margin-block-start: 1rem;
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .empty {
    padding: 3rem;
    text-align: center;
    color: var(--ink-2);
    border: 1px dashed var(--line-strong);
  }

  .cat__faq {
    margin-block-start: clamp(3rem, 7vw, 5rem);
    padding-block-start: clamp(2rem, 5vw, 3rem);
    border-block-start: 1px solid var(--line);
  }

  .guides {
    margin-block-start: clamp(2.5rem, 6vw, 4rem);
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--line);
  }

  .guides h2 { font-size: var(--step-2); }

  .guides ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 0.5rem;
    padding: 0;
    margin-block-start: 1rem;
    list-style: none;
  }

  .guides a {
    display: block;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--line);
    color: var(--ink);
    font-size: var(--step--1);
    text-decoration: none;
  }

  .guides a:hover { border-color: var(--accent); color: var(--accent); }

  .siblings {
    margin-block-start: clamp(2.5rem, 6vw, 4rem);
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--line);
  }

  .siblings ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin-block-start: 1rem;
    list-style: none;
  }

  .siblings a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--line);
    color: var(--ink-2);
    font-size: var(--step--1);
    text-decoration: none;
  }

  .siblings a:hover { border-color: var(--accent); color: var(--accent); }

  .siblings span {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-3);
  }

  @media (max-width: 900px) {
    .cat { grid-template-columns: 1fr; }
  }
</style>
