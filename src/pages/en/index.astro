---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGrid from '../../components/product/ProductGrid.astro';
import PostCard from '../../components/blog/PostCard.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import FAQ from '../../components/seo/FAQ.astro';
import { SHOPS, SITE, TOTAL_PRODUCTS, TOP_SELLER_KEYS, SHOP_BY_ID, type ShopId } from '../../data/site';
import { GLOBAL_FAQ } from '../../data/faq';
import { firstImage } from '../../lib/images';

const products = await getCollection('products');
const posts = (await getCollection('blog')).sort(
  (a, b) => Date.parse(b.data.publishedAt) - Date.parse(a.data.publishedAt)
);

// Only the shop's own best-seller lists appear on the homepage. These are
// real curated categories in the catalogue, not a ranking we invented — there
// is no sales or ratings feed to rank by.
const bestSellers = products
  .filter(
    (p) =>
      p.data.inStock &&
      p.data.images.length &&
      TOP_SELLER_KEYS.has(`${p.data.shop}/${p.data.category}`)
  )
  .sort((a, b) => (b.data.price ?? 0) - (a.data.price ?? 0));

// group them so each shop's list reads as its own top ten
const byShop = [...new Set(bestSellers.map((p) => p.data.shop))].map((id) => ({
  shop: SHOP_BY_ID.get(id as ShopId)!,
  items: bestSellers.filter((p) => p.data.shop === id),
}));

const hero = bestSellers[0];
const latest = posts.slice(0, 3);

// The order story, told as three real steps rather than marketing beats.
const steps = [
  {
    n: '01',
    icon: 'clock' as const,
    title: 'You order by 16:00',
    body: 'Pay in Bitcoin or by bank transfer. Minimum order €200 — mix anything to reach it. Nothing about the payment names what you bought.',
  },
  {
    n: '02',
    icon: 'package' as const,
    title: 'We pack it in Zürich',
    body: 'Picked from Swiss stock the same working day, into a plain box with no branding on the outside.',
  },
  {
    n: '03',
    icon: 'truck' as const,
    title: 'It arrives in 1–2 days',
    body: 'Tracked to your door anywhere in Switzerland. No customs, no waiting on a border.',
  },
];
---

<BaseLayout
  title={`${SITE.name} — ${SITE.tagline}`}
  description={SITE.description}
  bare
>
  <!-- ── hero ─────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container hero__in">
      <div class="hero__copy">
        <p class="eyebrow">Zürich · Switzerland · since {SITE.established}</p>
        <h1>Grow it, know it, then order it.</h1>
        <p class="hero__lead">
          A Swiss smartshop for people who want to understand what they are taking.
          {TOTAL_PRODUCTS.toLocaleString('en-CH')} products across six shops — and
          {posts.length} guides explaining them, written by people who actually use them.
        </p>
        <div class="hero__cta">
          <Button href="/en/shop/mushrooms" size="lg" iconEnd="arrow-right">Shop mushrooms</Button>
          <Button href="/en/blog" size="lg" variant="secondary">Start with a guide</Button>
        </div>
      </div>

      {
        hero && (
          <a class="hero__spec" href={`/en/product/${hero.slug}`}>
            <img
              src={firstImage(hero.data.images, 1000)}
              alt={hero.data.title}
              width="520"
              height="520"
              loading="eager"
              fetchpriority="high"
            />
            <span class="hero__tag">
              <span class="eyebrow">Best seller &middot; in stock</span>
              <strong>{hero.data.title}</strong>
            </span>
          </a>
        )
      }
    </div>

    <div class="container">
      <ul class="facts" role="list">
        <li><strong>{TOTAL_PRODUCTS.toLocaleString('en-CH')}</strong><span>products in stock</span></li>
        <li><strong>1–2</strong><span>days across Switzerland</span></li>
        <li><strong>{posts.length}</strong><span>guides, not blog filler</span></li>
        <li><strong>{new Date().getFullYear() - SITE.established}</strong><span>years shipping</span></li>
      </ul>
    </div>
  </section>

  <!-- ── shops ────────────────────────────────────────────────────────── -->
  <section class="container band">
    <header class="band__head">
      <h2>Six shops, one basket</h2>
      <p>Grouped by what you are trying to do, not by supplier.</p>
    </header>

    <ul class="shops" role="list">
      {
        SHOPS.map((shop) => (
          <li data-shop={shop.id}>
            <a class="shop" href={shop.href}>
              <span class="shop__icon"><Icon name={shop.icon} size={26} /></span>
              <span class="shop__top">
                <h3>{shop.label}</h3>
                <span class="shop__n">{shop.total}</span>
              </span>
              <p>{shop.blurb}</p>
              <span class="shop__go">
                Browse <Icon name="arrow-right" size={13} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ── how it works ─────────────────────────────────────────────────── -->
  <section class="band band--rule">
    <div class="container">
      <header class="band__head">
        <h2>Ordered today, on your table Thursday</h2>
        <p>No customs form, no foreign warehouse, no parcel that announces itself.</p>
      </header>

      <ol class="steps" role="list">
        {
          steps.map((s) => (
            <li>
              <span class="steps__head">
                <Icon name={s.icon} size={22} />
                <span class="steps__n">{s.n}</span>
              </span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ── the promise ──────────────────────────────────────────────────── -->
  <section class="band band--rule">
    <div class="container why">
      <div class="why__lead">
        <p class="eyebrow">Why people come back</p>
        <h2>Most of what we sell rewards knowing something first.</h2>
      </div>
      <div class="why__body">
        <p>
          A grow kit that fruits depends on temperature and patience. A kratom vein
          does something different at 2 g than at 6 g. CBD strength in Switzerland
          is not the strength you know from the EU.
        </p>
        <p>
          So the catalogue sits next to {posts.length} guides rather than behind a
          contact form. If a product needs a dosing note, a substrate recipe or a
          plain word of caution, it is written down — and linked from the product
          page, before you buy rather than after.
        </p>
        <p>
          <a href="/en/about">How we source and check what we stock</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ── best sellers ─────────────────────────────────────────────────── -->
  <section class="container band">
    <header class="band__head">
      <h2>What actually sells</h2>
      <p>
        {bestSellers.length} products, taken straight from our own top-ten lists rather
        than an algorithm's guess. Everything here is in stock today.
      </p>
    </header>

    {
      byShop.map(({ shop, items }) => (
        <div class="tops" data-shop={shop.id}>
          <div class="tops__head">
            <span class="tops__icon"><Icon name={shop.icon} size={20} /></span>
            <h3>Top {shop.label}</h3>
            <a href={shop.href}>
              All {shop.total} <Icon name="arrow-right" size={13} />
            </a>
          </div>
          <ProductGrid products={items} eagerCount={0} />
        </div>
      ))
    }
  </section>

  <!-- ── guides ───────────────────────────────────────────────────────── -->
  <section class="container band">
    <header class="band__head band__head--row">
      <div>
        <h2>Read before you buy</h2>
        <p>Cultivation notes, dosing guidance and the botany behind the shelf.</p>
      </div>
      <a class="band__link" href="/en/blog">All guides</a>
    </header>
    <div class="posts">
      {latest.map((p, i) => <PostCard post={p} eager={i === 0} />)}
    </div>
  </section>

  <!-- ── faq (answer engines) ─────────────────────────────────────────── -->
  <section class="container band">
    <FAQ items={GLOBAL_FAQ} title="Ordering from 24highshop" />
  </section>
</BaseLayout>

<style>
  /* ── hero ── */
  .hero {
    border-block-end: 1px solid var(--line);
  }

  .hero__in {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .hero h1 {
    max-width: 12ch;
    margin-block: 1rem 0;
    font-size: var(--step-6);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.98;
  }

  .hero__lead {
    max-width: 46ch;
    margin-block-start: 1.4rem;
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-block-start: 2rem;
  }

  .hero__spec {
    position: relative;
    display: block;
    border: 1px solid var(--line);
    text-decoration: none;
  }

  .hero__spec img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .hero__tag {
    display: block;
    padding: 0.85rem 1rem;
    border-block-start: 1px solid var(--line);
    background: var(--paper);
  }

  .hero__tag strong {
    display: block;
    margin-block-start: 0.2rem;
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--ink);
  }

  /* ── facts rail ── */
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(50%, 150px), 1fr));
    padding: 0;
    margin: 0;
    list-style: none;
    border-block-start: 1px solid var(--line);
  }

  .facts li {
    padding: 1.4rem 1.5rem 1.6rem 0;
  }

  .facts strong {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 700;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .facts span {
    display: block;
    margin-block-start: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }

  /* ── bands ── */
  .band { padding-block: clamp(3rem, 7vw, 5.5rem); }
  .band--rule { border-block-start: 1px solid var(--line); }

  .band__head { margin-block-end: 2rem; }

  .band__head h2 {
    font-size: var(--step-4);
    max-width: 20ch;
  }

  .band__head p {
    max-width: 54ch;
    margin-block-start: 0.7rem;
    color: var(--ink-2);
    font-size: var(--step-1);
  }

  .band__head--row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .band__link {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ── shops ── */
  .shops {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 0;
    padding: 0;
    margin: 0;
    list-style: none;
    border-block-start: 1px solid var(--line);
    border-inline-start: 1px solid var(--line);
  }

  .shop {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1.6rem 1.5rem 1.5rem;
    border-inline-end: 1px solid var(--line);
    border-block-end: 1px solid var(--line);
    text-decoration: none;
    transition: background-color 0.14s ease;
  }

  /* the shop's own colour, drawn as a rule that fills in on hover */
  .shop::before {
    content: '';
    position: absolute;
    inset-block-start: -1px;
    inset-inline: -1px 100%;
    height: 3px;
    background: var(--accent);
    transition: inset-inline-end 0.22s ease;
  }

  .shop:hover::before { inset-inline-end: -1px; }
  .shop:hover { background: var(--accent-soft); }

  .shop__icon {
    display: block;
    margin-block-end: 0.4rem;
    color: var(--accent);
  }

  .shop__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .shop h3 { font-size: var(--step-2); }

  .shop__n {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .shop p {
    flex: 1;
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .shop__go {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* ── steps ── */
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 0;
    padding: 0;
    margin: 0;
    list-style: none;
    border-block-start: 1px solid var(--line);
  }

  .steps li {
    padding: 1.8rem 2rem 2rem 0;
  }

  .steps__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--spruce);
  }

  .steps__n {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
  }

  .steps h3 {
    margin-block: 0.7rem 0.5rem;
    font-size: var(--step-1);
  }

  .steps p {
    max-width: 34ch;
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  /* ── why ── */
  .why {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .why__lead h2 {
    margin-block-start: 0.8rem;
    font-size: var(--step-3);
    max-width: 18ch;
  }

  .why__body p {
    color: var(--ink-2);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .why__body p + p { margin-block-start: 1.1rem; }

  /* ── best sellers ── */
  .tops + .tops { margin-block-start: 2.8rem; }

  .tops__head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-block-end: 1rem;
    padding-block-end: 0.7rem;
    border-block-end: 2px solid var(--accent);
  }

  .tops__icon { color: var(--accent); }

  .tops__head h3 {
    flex: 1;
    font-size: var(--step-1);
  }

  .tops__head a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }

  /* ── posts ── */
  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1.2rem;
  }

  @media (max-width: 900px) {
    .hero__in,
    .why { grid-template-columns: 1fr; }
    .hero__spec { max-width: 24rem; }
    .band__head--row { flex-direction: column; align-items: flex-start; gap: 1rem; }
  }
</style>
