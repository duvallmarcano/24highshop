---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGrid from '../../components/product/ProductGrid.astro';
import PostCard from '../../components/blog/PostCard.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import Stars from '../../components/product/Stars.astro';
import FAQ from '../../components/seo/FAQ.astro';
import { SHOPS, SITE, TOTAL_PRODUCTS, TOP_SELLER_KEYS } from '../../data/site';
import { GLOBAL_FAQ } from '../../data/faq';
import { firstImage } from '../../lib/images';

const products = await getCollection('products');
const posts = (await getCollection('blog')).sort(
  (a, b) => Date.parse(b.data.publishedAt) - Date.parse(a.data.publishedAt)
);

// Homepage leads with products customers have rated. Where a section cannot
// fill ten from those, it tops up with the best-standing unrated products —
// never repeating one that has already appeared further up the page.
const SECTION_SIZE = 10;

// naming the entry type keeps TypeScript from re-deriving a 1,187-member
// union every time a list is spread
type Product = CollectionEntry<'products'>;

const sellable = products.filter(
  (p) => p.data.inStock && p.data.images.length > 0 && p.data.shop
);
const rated = sellable.filter((p) => p.data.rating);

const used = new Set<string>();
const r = (p: Product) => p.data.rating!;

/**
 * Standing for a product nobody has rated yet. The strongest signal is the
 * shop's own curated top-ten lists — a human already picked those — then
 * depth of photography and of the written description.
 */
function standing(p: Product): number {
  const curated = TOP_SELLER_KEYS.has(`${p.data.shop}/${p.data.category}`) ? 100 : 0;
  const photos = Math.min(p.data.images.length, 4) * 8;
  const copy = Math.min(p.body.replace(/<[^>]+>/g, '').trim().length / 60, 20);
  return curated + photos + copy;
}

const unratedByStanding = sellable
  .filter((p) => !p.data.rating)
  .sort((a, b) => standing(b) - standing(a));

function take(list: Product[], n: number): Product[] {
  const out: Product[] = [];
  for (const p of list) {
    if (out.length >= n) break;
    if (used.has(p.slug)) continue;
    used.add(p.slug);
    out.push(p);
  }
  return out;
}

/** Fill a section to SECTION_SIZE, topping up with well-presented stock. */
function section(preferred: Product[], size = SECTION_SIZE): Product[] {
  const picked = take(preferred, size);
  if (picked.length < size) {
    for (const p of take(unratedByStanding, size - picked.length)) picked.push(p);
  }
  return picked;
}

// strongest score, but only where more than one person rated it
const byScore = [...rated]
  .filter((p) => r(p).count >= 2)
  .sort((a, b) => r(b).value - r(a).value || r(b).count - r(a).count);

// most-rated, regardless of score — the social-proof slice
const byCount = [...rated].sort((a, b) => r(b).count - r(a).count || r(b).value - r(a).value);

const hero = take(byScore, 1)[0] ?? take(byCount, 1)[0];
const mostReviewed = section(byCount);
const topRated = section(byScore);

// Breadth: rotate through the shops so all six appear, rated first within
// each. Without this, cbdshop (1 rated) and seedshop (2) never surface.
const perShop: Product[][] = SHOPS.map((shop) => {
  const mine = sellable.filter((p) => p.data.shop === shop.id);
  const queue: Product[] = mine
    .filter((p) => p.data.rating)
    .sort((a, b) => r(b).value - r(a).value);
  for (const p of mine.filter((x) => !x.data.rating).sort((a, b) => standing(b) - standing(a))) {
    queue.push(p);
  }
  return queue;
});
const roundRobin: Product[] = [];
for (let i = 0; roundRobin.length < SECTION_SIZE * 2 && i < 40; i++) {
  for (const list of perShop) if (list[i]) roundRobin.push(list[i]);
}
const acrossShops = section(roundRobin);

const latest = posts.slice(0, 3);

// The order story, told as three real steps rather than marketing beats.
const steps = [
  {
    n: '01',
    icon: 'clock' as const,
    title: 'You order by 16:00',
    body: 'Pay in Bitcoin or by bank transfer. Minimum order €200 — mix anything to reach it. Nothing about the payment names what you bought.',
  },
  {
    n: '02',
    icon: 'package' as const,
    title: 'We pack it in Zürich',
    body: 'Picked from Swiss stock the same working day, into a plain box with no branding on the outside.',
  },
  {
    n: '03',
    icon: 'truck' as const,
    title: 'It arrives in 1–2 days',
    body: 'Tracked to your door anywhere in Switzerland. No customs, no waiting on a border.',
  },
];
---

<BaseLayout
  title={`${SITE.name} — ${SITE.tagline}`}
  description={SITE.description}
  bare
>
  <!-- ── hero ─────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container hero__in">
      <div class="hero__copy">
        <p class="eyebrow">Zürich · Switzerland · since {SITE.established}</p>
        <h1>Grow it, know it, then order it.</h1>
        <p class="hero__lead">
          A Swiss smartshop for people who want to understand what they are taking.
          {TOTAL_PRODUCTS.toLocaleString('en-CH')} products across six shops — and
          {posts.length} guides explaining them, written by people who actually use them.
        </p>
        <div class="hero__cta">
          <Button href="/en/shop/mushrooms" size="lg" iconEnd="arrow-right">Shop mushrooms</Button>
          <Button href="/en/blog" size="lg" variant="secondary">Start with a guide</Button>
        </div>
      </div>

      {
        hero && (
          <a class="hero__spec" href={`/en/product/${hero.slug}`}>
            <img
              src={firstImage(hero.data.images, 1000)}
              alt={hero.data.title}
              width="520"
              height="520"
              loading="eager"
              fetchpriority="high"
            />
            <span class="hero__tag">
              <span class="hero__stars">
                <Stars value={hero.data.rating!.value} size={14} />
                <span>
                  {hero.data.rating!.value.toFixed(1)} from {hero.data.rating!.count} ratings
                </span>
              </span>
              <strong>{hero.data.title}</strong>
            </span>
          </a>
        )
      }
    </div>

    <div class="container">
      <ul class="facts" role="list">
        <li><strong>{TOTAL_PRODUCTS.toLocaleString('en-CH')}</strong><span>products in stock</span></li>
        <li><strong>1–2</strong><span>days across Switzerland</span></li>
        <li><strong>{posts.length}</strong><span>guides, not blog filler</span></li>
        <li><strong>{new Date().getFullYear() - SITE.established}</strong><span>years shipping</span></li>
      </ul>
    </div>
  </section>

  <!-- ── shops ────────────────────────────────────────────────────────── -->
  <section class="container band">
    <header class="band__head">
      <h2>Six shops, one basket</h2>
      <p>Grouped by what you are trying to do, not by supplier.</p>
    </header>

    <ul class="shops" role="list">
      {
        SHOPS.map((shop) => (
          <li data-shop={shop.id}>
            <a class="shop" href={shop.href}>
              <span class="shop__icon"><Icon name={shop.icon} size={26} /></span>
              <span class="shop__top">
                <h3>{shop.label}</h3>
                <span class="shop__n">{shop.total}</span>
              </span>
              <p>{shop.blurb}</p>
              <span class="shop__go">
                Browse <Icon name="arrow-right" size={13} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ── how it works ─────────────────────────────────────────────────── -->
  <section class="band band--rule">
    <div class="container">
      <header class="band__head">
        <h2>Ordered today, on your table Thursday</h2>
        <p>No customs form, no foreign warehouse, no parcel that announces itself.</p>
      </header>

      <ol class="steps" role="list">
        {
          steps.map((s) => (
            <li>
              <span class="steps__head">
                <Icon name={s.icon} size={22} />
                <span class="steps__n">{s.n}</span>
              </span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ── the promise ──────────────────────────────────────────────────── -->
  <section class="band band--rule">
    <div class="container why">
      <div class="why__lead">
        <p class="eyebrow">Why people come back</p>
        <h2>Most of what we sell rewards knowing something first.</h2>
      </div>
      <div class="why__body">
        <p>
          A grow kit that fruits depends on temperature and patience. A kratom vein
          does something different at 2 g than at 6 g. CBD strength in Switzerland
          is not the strength you know from the EU.
        </p>
        <p>
          So the catalogue sits next to {posts.length} guides rather than behind a
          contact form. If a product needs a dosing note, a substrate recipe or a
          plain word of caution, it is written down — and linked from the product
          page, before you buy rather than after.
        </p>
        <p>
          <a href="/en/about">How we source and check what we stock</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ── most reviewed ─────────────────────────────────────────────── -->
  <section class="container band">
    <header class="band__head band__head--row">
      <div>
        <h2>What people actually bought twice</h2>
        <p>Our most-rated products, ordered by how many customers left a score.</p>
      </div>
      <a class="band__link" href="/en/shop/mushrooms">Browse the shop</a>
    </header>
    <ProductGrid products={mostReviewed} eagerCount={4} />
  </section>

  <!-- ── highest rated ────────────────────────────────────────────────── -->
  <section class="band band--rule">
    <div class="container">
      <header class="band__head">
        <h2>Rated highest by the people who use them</h2>
        <p>
          Top scores, counting only products more than one customer has rated —
          a single five-star review does not put anything here.
        </p>
      </header>
      <ProductGrid products={topRated} eagerCount={0} />
    </div>
  </section>

  <!-- ── across the shops ─────────────────────────────────────────────── -->
  <section class="container band">
    <header class="band__head band__head--row">
      <div>
        <h2>Across every shop</h2>
        <p>
          One pass through all six shops, rated products first — so the smaller
          shelves are not buried under mushrooms and smartshop.
        </p>
      </div>
      <a class="band__link" href="/en/shop/mushrooms">Browse all shops</a>
    </header>
    <ProductGrid products={acrossShops} eagerCount={0} />
  </section>

  <!-- ── guides ───────────────────────────────────────────────────────── -->
  <section class="container band">
    <header class="band__head band__head--row">
      <div>
        <h2>Read before you buy</h2>
        <p>Cultivation notes, dosing guidance and the botany behind the shelf.</p>
      </div>
      <a class="band__link" href="/en/blog">All guides</a>
    </header>
    <div class="posts">
      {latest.map((p, i) => <PostCard post={p} eager={i === 0} />)}
    </div>
  </section>

  <!-- ── faq (answer engines) ─────────────────────────────────────────── -->
  <section class="container band">
    <FAQ items={GLOBAL_FAQ} title="Ordering from 24highshop" />
  </section>
</BaseLayout>

<style>
  /* ── hero ── */
  .hero {
    border-block-end: 1px solid var(--line);
  }

  .hero__in {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .hero h1 {
    max-width: 12ch;
    margin-block: 1rem 0;
    font-size: var(--step-6);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.98;
  }

  .hero__lead {
    max-width: 46ch;
    margin-block-start: 1.4rem;
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-block-start: 2rem;
  }

  .hero__spec {
    position: relative;
    display: block;
    border: 1px solid var(--line);
    text-decoration: none;
  }

  .hero__spec img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .hero__tag {
    display: block;
    padding: 0.85rem 1rem;
    border-block-start: 1px solid var(--line);
    background: var(--paper);
  }

  .hero__stars {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-3);
  }

  .hero__tag strong {
    display: block;
    margin-block-start: 0.2rem;
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--ink);
  }

  /* ── facts rail ── */
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(50%, 150px), 1fr));
    padding: 0;
    margin: 0;
    list-style: none;
    border-block-start: 1px solid var(--line);
  }

  .facts li {
    padding: 1.4rem 1.5rem 1.6rem 0;
  }

  .facts strong {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 700;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .facts span {
    display: block;
    margin-block-start: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }

  /* ── bands ── */
  .band { padding-block: clamp(3rem, 7vw, 5.5rem); }
  .band--rule { border-block-start: 1px solid var(--line); }

  .band__head { margin-block-end: 2rem; }

  .band__head h2 {
    font-size: var(--step-4);
    max-width: 20ch;
  }

  .band__head p {
    max-width: 54ch;
    margin-block-start: 0.7rem;
    color: var(--ink-2);
    font-size: var(--step-1);
  }

  .band__head--row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .band__link {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ── shops ── */
  .shops {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 0;
    padding: 0;
    margin: 0;
    list-style: none;
    border-block-start: 1px solid var(--line);
    border-inline-start: 1px solid var(--line);
  }

  .shop {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1.6rem 1.5rem 1.5rem;
    border-inline-end: 1px solid var(--line);
    border-block-end: 1px solid var(--line);
    text-decoration: none;
    transition: background-color 0.14s ease;
  }

  /* the shop's own colour, drawn as a rule that fills in on hover */
  .shop::before {
    content: '';
    position: absolute;
    inset-block-start: -1px;
    inset-inline: -1px 100%;
    height: 3px;
    background: var(--accent);
    transition: inset-inline-end 0.22s ease;
  }

  .shop:hover::before { inset-inline-end: -1px; }
  .shop:hover { background: var(--accent-soft); }

  .shop__icon {
    display: block;
    margin-block-end: 0.4rem;
    color: var(--accent);
  }

  .shop__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .shop h3 { font-size: var(--step-2); }

  .shop__n {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .shop p {
    flex: 1;
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .shop__go {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* ── steps ── */
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 0;
    padding: 0;
    margin: 0;
    list-style: none;
    border-block-start: 1px solid var(--line);
  }

  .steps li {
    padding: 1.8rem 2rem 2rem 0;
  }

  .steps__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--spruce);
  }

  .steps__n {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
  }

  .steps h3 {
    margin-block: 0.7rem 0.5rem;
    font-size: var(--step-1);
  }

  .steps p {
    max-width: 34ch;
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  /* ── why ── */
  .why {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .why__lead h2 {
    margin-block-start: 0.8rem;
    font-size: var(--step-3);
    max-width: 18ch;
  }

  .why__body p {
    color: var(--ink-2);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .why__body p + p { margin-block-start: 1.1rem; }

  /* ── best sellers ── */
  .tops + .tops { margin-block-start: 2.8rem; }

  .tops__head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-block-end: 1rem;
    padding-block-end: 0.7rem;
    border-block-end: 2px solid var(--accent);
  }

  .tops__icon { color: var(--accent); }

  .tops__head h3 {
    flex: 1;
    font-size: var(--step-1);
  }

  .tops__head a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }

  /* ── posts ── */
  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1.2rem;
  }

  @media (max-width: 900px) {
    .hero__in,
    .why { grid-template-columns: 1fr; }
    .hero__spec { max-width: 24rem; }
    .band__head--row { flex-direction: column; align-items: flex-start; gap: 1rem; }
  }
</style>
