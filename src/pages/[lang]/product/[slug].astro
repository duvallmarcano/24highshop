---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import Gallery from '../../../components/product/Gallery.astro';
import BuyBox from '../../../components/product/BuyBox.astro';
import ProductSchema from '../../../components/product/ProductSchema.astro';
import ProductRail from '../../../components/product/ProductRail.astro';
import Reviews from '../../../components/product/Reviews.astro';
import Stars from '../../../components/product/Stars.astro';
import FAQ from '../../../components/seo/FAQ.astro';
import KeyFacts from '../../../components/seo/KeyFacts.astro';
import Money from '../../../components/ui/Money.astro';
import { SHOP_BY_ID, SITE, toCHF, type ShopId } from '../../../data/site';
import { productFAQ, SHOP_FAQ } from '../../../data/faq';
import { breadcrumbSchema } from '../../../lib/seo';
import { alignDescription } from '../../../lib/keywords';
import { firstImage } from '../../../lib/images';
import { ENABLED_LOCALES, localized } from '../../../lib/i18n';
import type { LocaleCode } from '../../../data/site';
import { useTranslations } from '../../../i18n/ui';

// the locale segment drives every link and every string on the page
const lang = Astro.params.lang as LocaleCode;
const L = (p: string) => localized(p, lang);
const t = useTranslations(lang);

export async function getStaticPaths() {
  const products = await getCollection('products');
  // push rather than spread: spreading the entry union across 1,187 items
  // produces a type TypeScript cannot represent
  const byCategory = new Map<string, CollectionEntry<'products'>[]>();
  for (const p of products) {
    const key = `${p.data.shop}/${p.data.category}`;
    const bucket = byCategory.get(key);
    if (bucket) bucket.push(p);
    else byCategory.set(key, [p]);
  }

  return ENABLED_LOCALES.flatMap((lang) =>
    products.map((entry) => ({
      params: { lang, slug: entry.slug },
    props: {
      entry,
      related: (byCategory.get(`${entry.data.shop}/${entry.data.category}`) ?? [])
        .filter((p) => p.slug !== entry.slug && p.data.images.length)
        .slice(0, 8),
    },
    }))
  );
}

interface Props {
  entry: CollectionEntry<'products'>;
  related: CollectionEntry<'products'>[];
}

const { entry, related } = Astro.props;
const { title, description, sku, price, inStock, shop, category, categoryLabel, images,
  rating, reviews } = entry.data;
const { Content } = await entry.render();

const shopMeta = SHOP_BY_ID.get(shop as ShopId);
const url = `/product/${entry.slug}`;

const crumbs = [
  { label: t('page.home'), href: L('/') },
  ...(shopMeta ? [{ label: t(`shopmeta.${shop}.label` as never), href: L(shopMeta.href) }] : []),
  ...(categoryLabel ? [{ label: categoryLabel, href: L(`/shop/${shop}/${category}`) }] : []),
  { label: title },
];

const chf = price === null ? null : toCHF(price);

// Scannable facts, placed above the description so both a hurried reader and
// an answer engine hit the specifics first.
const facts = [
  // rendered through <Money> so it follows the currency switcher
  ...(chf !== null && price !== null
    ? [{ label: t('page.price'), eur: price, chf, suffix: t('footer.vatNote') }]
    : []),
  { label: t('page.availability'), value: inStock ? t('page.inStockShips') : t('page.currentlySoldOut') },
  { label: t('page.articleNo'), value: sku },
  ...(categoryLabel ? [{ label: t('page.category'), value: categoryLabel }] : []),
  { label: t('page.shipsFrom'), value: `${SITE.address.locality}, ${SITE.address.countryName}` },
  { label: t('page.delivery'), value: t('page.deliveryValue') },
  { label: t('page.packaging'), value: t('page.packagingValue') },
];

// Product-specific questions first, then the ones people ask about the shop
// this product belongs to.
const faqs = [
  ...productFAQ({ title, priceEUR: price, inStock, categoryLabel, shop }, lang),
  ...(SHOP_FAQ[shop as ShopId] ?? []).slice(0, 2),
];

const metaDescription = alignDescription(
  description ||
    `${title}${chf !== null ? ` — CHF ${chf.toFixed(2)}` : ''}. In stock in Zürich, shipped discreetly across Switzerland in 1–2 working days.`,
  url
);
---

<BaseLayout
  title={title}
  description={metaDescription}
  image={firstImage(images, 1000)}
  type="product"
  activeShop={shop}
  schemas={[breadcrumbSchema(crumbs)]}
>
  <ProductSchema
    title={title}
    description={metaDescription}
    sku={sku}
    priceEUR={price}
    inStock={inStock}
    images={images}
    url={url}
    category={categoryLabel}
    rating={rating}
    reviews={reviews}
  />

  <Breadcrumbs items={crumbs} />

  <div class="pdp" data-shop={shop}>
    <div class="pdp__media">
      <Gallery images={images} alt={title} />
    </div>

    <div class="pdp__info">
      {categoryLabel && (
        <a class="pdp__cat eyebrow" href={L(`/shop/${shop}/${category}`)}>{categoryLabel}</a>
      )}
      <h1>{title}</h1>
      {
        rating && (
          <a class="pdp__rating" href="#reviews">
            <Stars value={rating.value} size={15} />
            <span>
              {rating.value.toFixed(1)} · {rating.count} review
              {rating.count === 1 ? '' : 's'}
            </span>
          </a>
        )
      }
      {description && <p class="pdp__lead">{description}</p>}
      <BuyBox title={title} sku={sku} price={price} inStock={inStock} lang={lang} />
    </div>
  </div>

  <div class="pdp__detail">
    <section class="pdp__desc">
      <h2>{t('product.description')}</h2>
      <div class="prose"><Content /></div>
    </section>

    <aside class="pdp__aside">
      <KeyFacts facts={facts} title={t('page.atAGlance')} />
    </aside>
  </div>

  <section class="pdp__reviews">
    <Reviews reviews={reviews} rating={rating} productTitle={title} lang={lang} />
  </section>

  <section class="pdp__faq">
    <FAQ items={faqs} title={t('product.faq')} />
  </section>

  <ProductRail
    title={t('product.related', { category: categoryLabel || t(`shopmeta.${shop}.label` as never) })}
    products={related}
    lang={lang}
    href={L(`/shop/${shop}/${category}`)}
  />
</BaseLayout>

<style>
  .pdp {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    margin-block-start: 1.5rem;
  }

  .pdp__info {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .pdp__cat {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    background: var(--accent-soft);
    color: var(--accent);
    text-decoration: none;
  }

  .pdp__info h1 {
    font-size: var(--step-4);
    letter-spacing: -0.035em;
  }

  .pdp__rating {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-3);
    text-decoration: none;
  }

  .pdp__rating:hover { color: var(--ink); }

  .pdp__lead {
    max-width: 52ch;
    color: var(--ink-2);
    line-height: 1.6;
  }

  .pdp__detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 22rem;
    gap: clamp(1.5rem, 5vw, 4rem);
    margin-block-start: clamp(2.5rem, 6vw, 4rem);
    padding-block-start: clamp(2rem, 5vw, 3rem);
    border-block-start: 1px solid var(--line);
  }

  .pdp__desc h2 {
    margin-block-end: 1.2rem;
    font-size: var(--step-2);
  }

  .pdp__reviews,
  .pdp__faq {
    margin-block-start: clamp(2.5rem, 6vw, 4rem);
    padding-block-start: clamp(2rem, 5vw, 3rem);
    border-block-start: 1px solid var(--line);
  }

  @media (max-width: 900px) {
    .pdp,
    .pdp__detail { grid-template-columns: 1fr; }
  }
</style>
