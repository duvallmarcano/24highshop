---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { INFO_SLUGS, infoPage, type InfoPage } from '../../data/info-pages';
import { breadcrumbSchema } from '../../lib/seo';
import { ENABLED_LOCALES, localized } from '../../lib/i18n';
import type { LocaleCode } from '../../data/site';
import { useTranslations } from '../../i18n/ui';

// the locale segment drives every link and every string on the page
const lang = Astro.params.lang as LocaleCode;
const L = (p: string) => localized(p, lang);
const t = useTranslations(lang);

// copy comes from the locale table, not from props
const page = infoPage(Astro.params.info as string, lang) as InfoPage;

export function getStaticPaths() {
  // one copy of each info page per enabled locale
  return ENABLED_LOCALES.flatMap((lang) =>
    INFO_SLUGS.map((slug) => ({ params: { lang, info: slug } }))
  );
}


const crumbs = [{ label: t('page.home'), href: L('/') }, { label: page.title }];
---

<BaseLayout
  title={page.title}
  description={page.description}
  schemas={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs items={crumbs} />

  <article class="info">
    <h1>{page.title}</h1>
    <p class="info__intro">{page.intro}</p>

    <div class="prose">
      {
        page.sections.map((s) => (
          <>
            <h2>{s.heading}</h2>
            {s.body.map((para) => (
              <p>{para}</p>
            ))}
          </>
        ))
      }
    </div>
  </article>
</BaseLayout>

<style>
  .info {
    max-width: var(--container-prose);
    margin-inline: auto;
    padding-block: 1.5rem;
  }

  .info h1 {
    font-size: var(--step-4);
    letter-spacing: -0.035em;
  }

  .info__intro {
    margin-block: 1rem 2rem;
    padding-block-end: 1.5rem;
    border-block-end: 1px solid var(--line);
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  /* the first heading already has the intro rule above it */
  .info .prose > h2:first-child {
    margin-block-start: 0;
  }
</style>
