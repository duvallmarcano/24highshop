---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/layout/Breadcrumbs.astro';
import ProductGrid from '../../../../components/product/ProductGrid.astro';
import FAQ from '../../../../components/seo/FAQ.astro';
import Icon from '../../../../components/ui/Icon.astro';
import Money from '../../../../components/ui/Money.astro';
import { SHOPS, SITE, toCHF, type Shop, type ShopId } from '../../../../data/site';
import { SHOP_FAQ } from '../../../../data/faq';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '../../../../lib/seo';
import { ENABLED_LOCALES, localized } from '../../../../lib/i18n';
import type { LocaleCode } from '../../../../data/site';

// the locale segment drives every link and every string on the page
const lang = Astro.params.lang as LocaleCode;
const L = (p: string) => localized(p, lang);

export async function getStaticPaths() {
  const products = await getCollection('products');
  return ENABLED_LOCALES.flatMap((lang) => SHOPS.map((shop) => ({
    params: { lang, shop: shop.id },
    props: { shop, products: products.filter((p) => p.data.shop === shop.id) },
  })));
}

interface Props {
  shop: Shop;
  products: CollectionEntry<'products'>[];
}

const { shop, products } = Astro.props;

const highlights = products.filter((p) => p.data.inStock && p.data.images.length).slice(0, 12);
const prices = products.map((p) => p.data.price).filter((p): p is number => p !== null);
const fromEUR = prices.length ? Math.min(...prices) : null;
const fromCHF = fromEUR === null ? null : toCHF(fromEUR);
const available = products.filter((p) => p.data.inStock).length;

const crumbs = [{ label: 'Home', href: L('/') }, { label: shop.label }];
const description = `${shop.label} at 24highshop — ${shop.total} products across ${shop.categories.length} categories${
  fromCHF !== null ? `, from CHF ${fromCHF.toFixed(2)}` : ''
}. Shipped from Zürich in 1–2 working days.`;

const answerLead = `24highshop’s ${shop.label.toLowerCase()} carries ${shop.total} products in ${
  shop.categories.length
} categories`;
const answerTail = `. ${available} are in stock in ${SITE.address.locality} today and ship the same working day when ordered before ${SITE.cutoff}.`;
const answer = `${answerLead}${
  fromCHF !== null ? `, starting at CHF ${fromCHF.toFixed(2)}` : ''
}${answerTail}`;
---

<BaseLayout
  title={`${shop.label} — ${shop.total} products`}
  description={description}
  activeShop={shop.id}
  schemas={[
    breadcrumbSchema(crumbs),
    collectionPageSchema(shop.label, description, shop.href),
    itemListSchema(
      highlights.map((p) => ({ slug: p.slug, title: p.data.title, price: p.data.price })),
      shop.label
    ),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <header class="shophead" data-shop={shop.id}>
    <span class="shophead__icon"><Icon name={shop.icon} size={40} /></span>
    <p class="eyebrow">{shop.categories.length} categories · {shop.total} products</p>
    <h1>{shop.label}</h1>
    <p class="shophead__answer">
      {answerLead}
      {fromEUR !== null && (
        <>, starting at <Money eur={fromEUR} chf={fromCHF!} /></>
      )}
      {answerTail}
    </p>
    <p class="shophead__intro">{shop.intro}</p>
  </header>

  <section class="section" data-shop={shop.id}>
    <h2 class="section__title">Browse by category</h2>
    <ul class="cats" role="list">
      {
        shop.categories.map((c) => (
          <li>
            <a href={c.href}>
              <span>{c.label}</span>
              <span class="cats__n">
                {c.count}
                <Icon name="chevron-right" size={12} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h2 class="section__title">In stock now</h2>
    <ProductGrid products={highlights} eagerCount={6} lang={lang} />
  </section>

  <section class="section section--rule">
    <FAQ items={SHOP_FAQ[shop.id as ShopId] ?? []} title={`${shop.label} — common questions`} />
  </section>
</BaseLayout>

<style>
  .shophead {
    margin-block: 1.5rem 0;
    padding-block: 1.5rem 2.5rem;
    border-block-start: 4px solid var(--accent);
    border-block-end: 1px solid var(--line);
  }

  .shophead__icon {
    display: block;
    margin-block-end: 1rem;
    color: var(--accent);
  }

  .shophead h1 {
    margin-block: 0.6rem 0;
    font-size: var(--step-5);
    letter-spacing: -0.04em;
  }

  /* direct answer first, then the positioning copy */
  .shophead__answer {
    max-width: 62ch;
    margin-block-start: 1.1rem;
    color: var(--ink);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .shophead__intro {
    max-width: 68ch;
    margin-block-start: 1rem;
    color: var(--ink-2);
    line-height: 1.65;
  }

  .section { padding-block: clamp(2.5rem, 6vw, 4rem); }
  .section--rule { border-block-start: 1px solid var(--line); }

  .section__title {
    margin-block-end: 1.4rem;
    font-size: var(--step-2);
  }

  .cats {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 0;
    padding: 0;
    margin: 0;
    list-style: none;
    border-block-start: 1px solid var(--line);
    border-inline-start: 1px solid var(--line);
  }

  .cats a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.85rem 1rem;
    border-inline-end: 1px solid var(--line);
    border-block-end: 1px solid var(--line);
    color: var(--ink);
    font-size: var(--step--1);
    text-decoration: none;
    transition: background-color 0.14s ease;
  }

  .cats a:hover { background: var(--accent-soft); color: var(--accent); }

  .cats__n {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
</style>
