---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import KeyFacts from '../../components/seo/KeyFacts.astro';
import FAQ from '../../components/seo/FAQ.astro';
import { SHOPS, SITE, TOTAL_PRODUCTS } from '../../data/site';
import { globalFAQ } from '../../data/faq';
import { AUTHORS } from '../../lib/authors';
import { breadcrumbSchema } from '../../lib/seo';
import { useTranslations } from '../../i18n/ui';
import { ENABLED_LOCALES, localized } from '../../lib/i18n';
import type { LocaleCode } from '../../data/site';

// one copy of this page per enabled locale
export function getStaticPaths() {
  return ENABLED_LOCALES.map((lang) => ({ params: { lang } }));
}

// the locale segment drives every link and every string on the page
const lang = Astro.params.lang as LocaleCode;
const L = (p: string) => localized(p, lang);
const t = useTranslations(lang);

const posts = await getCollection('blog');
const crumbs = [{ label: 'Home', href: L('/') }, { label: 'About' }];

const facts = [
  { label: 'Legal name', value: SITE.legalName },
  { label: 'Registered', value: `${SITE.address.locality}, Switzerland` },
  { label: 'Trading since', value: String(SITE.established) },
  { label: 'VAT / UID', value: SITE.uid },
  { label: 'Catalogue', value: `${TOTAL_PRODUCTS.toLocaleString('en-CH')} products, ${SHOPS.length} shops` },
  { label: 'Guides', value: `${posts.length}, by ${AUTHORS.length} named writers` },
  { label: 'Contact', value: SITE.email },
];
---

<BaseLayout
  title="About 24highshop"
  description={`24highshop is a Swiss smartshop based in ${SITE.address.locality}, trading since ${SITE.established}. What we stock, how we check it, and how we ship it.`}
  schemas={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs items={crumbs} />

  <div class="about">
    <header class="about__head">
      <p class="eyebrow">Zürich · since {SITE.established}</p>
      <h1>A smartshop that answers its own questions.</h1>
      <p class="about__answer">
        24highshop is a Swiss smartshop based in {SITE.address.locality}, trading since
        {SITE.established}. We stock {TOTAL_PRODUCTS.toLocaleString('en-CH')} products
        across {SHOPS.length} shops — mycology, botanicals, CBD, cannabis genetics and
        the hardware that goes with them — and ship them from Swiss stock in plain
        packaging, usually within one to two working days.
      </p>
    </header>

    <div class="about__body">
      <div class="prose">
        <h2>What we actually do</h2>
        <p>
          We buy from European growers and labs we have worked with for years, hold
          the stock ourselves in Zürich, and ship it the same day where we can.
          Nothing here is dropshipped from a warehouse we have never seen.
        </p>
        <p>
          Holding our own stock is the part that matters. It means we know how old a
          grow kit is, whether a batch of truffles travelled well, and which supplier
          quietly changed a formulation. It also means when something is listed as in
          stock, it is on a shelf a few kilometres from the post office.
        </p>

        <h2>Why the guides exist</h2>
        <p>
          Most of what we sell rewards knowing something first. A grow kit that fruits
          depends on temperature and patience. A kratom vein does something different
          at 2&nbsp;g than at 6&nbsp;g. Swiss CBD is legal below 1% THC — several times
          the EU threshold — so strength here is not the strength you know from abroad.
        </p>
        <p>
          So we publish {posts.length} guides, written by <a href={L("/authors")}>named
          people</a> rather than anonymously, and checked in-house before they go up.
          Where a product needs a dosing note or a plain word of caution, it is written
          down and linked from the product page — before you buy, not after.
        </p>

        <h2>Where Swiss law sits</h2>
        <p>
          Switzerland is not the Netherlands and it is not the EU. Cannabis below 1% THC
          is legal to sell and grow here. Psilocybin is not — we supply grow kits, spores
          and equipment, not controlled substances. Kratom is unlisted but unauthorised as
          a foodstuff, so it is sold as a botanical specimen.
        </p>
        <p>
          Rules differ again wherever you are, and they change. Checking what may lawfully
          be imported where you live is your responsibility, and we would much rather you
          asked us first than found out from customs.
        </p>

        <h2>Age and responsible use</h2>
        <p>
          Strictly 18+, with no exceptions. Start low, do not combine substances, do not
          drive, and if you take prescription medication — particularly antidepressants,
          MAO inhibitors or blood pressure medication — talk to a professional before
          using anything psychoactive. Our <a href={L("/disclaimer")}>disclaimer</a> sets
          out the limits of what we can tell you.
        </p>
      </div>

      <aside class="about__aside">
        <KeyFacts facts={facts} title="Company details" />
      </aside>
    </div>

    <section class="about__faq">
      <FAQ items={globalFAQ(lang)} title={t('page.faqTitle')} />
    </section>
  </div>
</BaseLayout>

<style>
  .about { padding-block: 1.5rem; }

  .about__head {
    padding-block-end: 2.5rem;
    border-block-end: 1px solid var(--line);
  }

  .about__head h1 {
    margin-block: 0.6rem 0;
    font-size: var(--step-5);
    max-width: 18ch;
    letter-spacing: -0.04em;
  }

  .about__answer {
    max-width: 64ch;
    margin-block-start: 1.2rem;
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .about__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: start;
    padding-block: 3rem;
  }

  .about__body :global(.prose > h2:first-child) { margin-block-start: 0; }

  .about__faq {
    padding-block-start: 2.5rem;
    border-block-start: 1px solid var(--line);
  }

  @media (max-width: 900px) {
    .about__body { grid-template-columns: 1fr; }
  }
</style>
