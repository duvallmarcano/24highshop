---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import AuthorBox from '../../../components/blog/AuthorBox.astro';
import { formatDate } from '../../../lib/format';
import { authorByName, authorImage } from '../../../lib/authors';
import { articleSchema, breadcrumbSchema } from '../../../lib/seo';
import { alignDescription, relatedGuides } from '../../../lib/keywords';
import { ENABLED_LOCALES, localized } from '../../../lib/i18n';
import type { LocaleCode } from '../../../data/site';

// the locale segment drives every link and every string on the page
const lang = Astro.params.lang as LocaleCode;
const L = (p: string) => localized(p, lang);

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort(
    (a, b) => Date.parse(b.data.publishedAt) - Date.parse(a.data.publishedAt)
  );

  return ENABLED_LOCALES.flatMap((lang) =>
    posts.map((entry, i) => ({
      params: { lang, slug: entry.slug },
    props: {
      entry,
      more: [posts[i + 1], posts[i + 2], posts[i - 1]].filter(Boolean).slice(0, 3),
      bySlug: Object.fromEntries(posts.map((p) => [p.slug, p])),
    },
    }))
  );
}

interface Props {
  entry: CollectionEntry<'blog'>;
  more: CollectionEntry<'blog'>[];
  bySlug: Record<string, CollectionEntry<'blog'>>;
}

const { entry, more, bySlug } = Astro.props;
const { title, description, heroImage, publishedAt, updatedAt, author } = entry.data;
const { Content } = await entry.render();

const person = authorByName(author);
const url = `/blog/${entry.slug}`;

// reading time from the rendered body, not a guess
const words = entry.body.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));

const crumbs = [
  { label: 'Home', href: L('/') },
  { label: 'Guides', href: L('/blog') },
  { label: title },
];

// Search data for this exact guide: the queries it already surfaces for.
// Used to phrase the meta description the way people actually search, and
// to surface the questions this guide answers.
const metaDescription = alignDescription(description, url);
// guides covering the same ground, matched on shared search vocabulary
const related = relatedGuides(url, 4);
---

<BaseLayout
  title={title}
  description={metaDescription}
  image={heroImage}
  type="article"
  schemas={[
    breadcrumbSchema(crumbs),
    articleSchema({
      title,
      description,
      image: heroImage,
      published: publishedAt,
      modified: updatedAt || publishedAt,
      url,
      wordCount: words,
      author: person
        ? {
            name: person.name,
            slug: person.slug,
            bio: person.bio[0],
            image: authorImage(person, 400),
          }
        : { name: author },
    }),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <article class="article">
    <header class="article__head">
      <h1>{title}</h1>
      <p class="article__meta">
        <span>{person ? person.name : 'The 24highshop editorial team'}</span>
        <span aria-hidden="true">·</span>
        <time datetime={publishedAt}>{formatDate(publishedAt, lang)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
      </p>
      {description && <p class="article__standfirst">{description}</p>}
    </header>

    {
      heroImage && (
        <img
          class="article__hero"
          src={heroImage}
          alt=""
          width="800"
          height="600"
          loading="eager"
          fetchpriority="high"
        />
      )
    }

    <div class="prose"><Content /></div>

    <AuthorBox
      author={person}
      updated={formatDate(updatedAt || publishedAt, lang)}
      lang={lang}
    />
  </article>

  {
    (() => {
      // prefer guides that share search vocabulary; fall back to neighbours by date
      const matched = related
        .map((r) => bySlug[r.route.replace('/blog/', '')])
        .filter(Boolean) as CollectionEntry<'blog'>[];
      const picks = (matched.length >= 2 ? matched : more).slice(0, 3);
      return picks.length > 0 ? (
        <section class="more">
          <h2>Related guides</h2>
          <div class="more__grid">
            {picks.map((p) => (
              <PostCard post={p} lang={lang} />
            ))}
          </div>
        </section>
      ) : null;
    })()
  }
</BaseLayout>

<style>
  .article {
    max-width: var(--container-prose);
    margin-inline: auto;
    margin-block-start: 2rem;
  }

  .article__head h1 {
    font-size: var(--step-5);
    letter-spacing: -0.04em;
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-block-start: 1rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }

  .article__standfirst {
    margin-block-start: 1.2rem;
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .article__hero {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    margin-block: 2rem;
    border: 1px solid var(--line);
  }

  .article :global(.prose) { margin-block-end: 2.5rem; }

  .more {
    max-width: var(--container);
    margin-block-start: clamp(3rem, 7vw, 5rem);
    padding-block-start: 2rem;
    border-block-start: 1px solid var(--line);
  }

  .more h2 {
    margin-block-end: 1.4rem;
    font-size: var(--step-2);
  }

  .more__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1.2rem;
  }
</style>
