---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import { AUTHORS, authorImage } from '../../../lib/authors';
import { breadcrumbSchema } from '../../../lib/seo';
import { ENABLED_LOCALES, localized } from '../../../lib/i18n';
import type { LocaleCode } from '../../../data/site';

// one copy of this page per enabled locale
export function getStaticPaths() {
  return ENABLED_LOCALES.map((lang) => ({ params: { lang } }));
}

// the locale segment drives every link and every string on the page
const lang = Astro.params.lang as LocaleCode;
const L = (p: string) => localized(p, lang);

const posts = await getCollection('blog');
const countFor = (name: string) =>
  posts.filter((p) => p.data.author.toLowerCase() === name.toLowerCase()).length;

const crumbs = [{ label: 'Home', href: L('/') }, { label: 'Our writers' }];
---

<BaseLayout
  title="Our writers"
  description="The people who write the 24highshop guides — who they are, what they know, and what they cover."
  schemas={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs items={crumbs} />

  <header class="head">
    <p class="eyebrow">Editorial</p>
    <h1>Who writes this</h1>
    <p class="head__lead">
      Guides are written by named people with a track record in the subject, then
      checked in-house before publication. If something here is wrong, there is a
      person to hold to it — that is the point.
      <a href={L("/editorial-policy")}>Read our editorial standards</a>.
    </p>
  </header>

  <ul class="authors" role="list">
    {
      AUTHORS.map((a) => (
        <li>
          <a class="author" href={L(`/authors/${a.slug}`)}>
            {a.image && (
              <img src={authorImage(a, 300)} alt={a.name} width="88" height="88" loading="lazy" />
            )}
            <div>
              <h2>{a.name}</h2>
              <p class="author__n">{countFor(a.name)} guides</p>
              {a.bio[0] && <p class="author__bio">{a.bio[0]}</p>}
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .head {
    margin-block: 1.5rem 2.5rem;
    padding-block-end: 2rem;
    border-block-end: 1px solid var(--line);
  }

  .head h1 {
    margin-block: 0.6rem 0;
    font-size: var(--step-5);
    letter-spacing: -0.04em;
  }

  .head__lead {
    max-width: 60ch;
    margin-block-start: 1.1rem;
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .authors {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 0;
    padding: 0;
    margin: 0;
    list-style: none;
    border-block-start: 1px solid var(--line);
    border-inline-start: 1px solid var(--line);
  }

  .author {
    display: flex;
    gap: 1.1rem;
    height: 100%;
    padding: 1.5rem;
    border-inline-end: 1px solid var(--line);
    border-block-end: 1px solid var(--line);
    text-decoration: none;
    transition: background-color 0.14s ease;
  }

  .author:hover { background: var(--surface-2); }

  .author img {
    flex: none;
    width: 88px;
    height: 88px;
    object-fit: cover;
    border-radius: 50%;
  }

  .author h2 {
    font-size: var(--step-1);
    color: var(--ink);
  }

  .author__n {
    margin-block: 0.2rem 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .author__bio {
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
